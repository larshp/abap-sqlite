{
  "name": "abap-sqlite",
  "version": "0.1.0",
  "private": true,
  "description": "A pure ABAP implementation of the SQLite database engine",
  "license": "MIT",
  "scripts": {
    "lint": "abaplint",
    "unit": "rimraf output && abap_transpile && node output/index.mjs",
    "benchmark": "rimraf output && abap_transpile && node test/benchmark.mjs",
    "fixtures": "node test/tools/make-fixtures.mjs",
    "verify": "node test/tools/export-and-verify.mjs",
    "test": "npm run lint && npm run unit && npm run verify"
  },
  "dependencies": {
    "@abaplint/cli": "^2.120.95",
    "@abaplint/database-sqlite": "^2.14.12",
    "@abaplint/runtime": "^2.14.18",
    "@abaplint/transpiler-cli": "^2.14.18",
    "rimraf": "^6.1.4"
  },
  "devDependencies": {
    "sql.js": "^1.15.2"
  }
}
